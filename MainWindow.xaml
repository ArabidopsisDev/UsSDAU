<Window x:Class="UsSDAU.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsSDAU" Icon="/Assets/UsSDAU-icon-v2.ico" Width="1320" Height="850" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#52647D"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="NavShell" Background="{TemplateBinding Background}" CornerRadius="13" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavShell" Property="Background" Value="#F0F4FA"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavGlyph" TargetType="Border">
            <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="#EEF3FA"/><Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition/></Grid.ColumnDefinitions>

        <Border Margin="14" Background="#FCFDFF" CornerRadius="24" BorderBrush="#E5EAF2" BorderThickness="1">
            <Border.Effect><DropShadowEffect Color="#182B4D" BlurRadius="24" ShadowDepth="5" Opacity="0.08"/></Border.Effect>
            <Grid Margin="18,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="15" Background="#EEF4FF">
                        <Image Source="/Assets/UsSDAU-logo-square-v2.png" Margin="5"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,2,0,0">
                        <TextBlock Text="UsSDAU" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Academic desktop" Foreground="#8391A5" FontSize="10" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,35,0,0">
                    <TextBlock Text="工作台" Foreground="#98A4B5" FontSize="11" FontWeight="SemiBold" Margin="12,0,0,8"/>
                    <Button x:Name="DayNav" Tag="day" Style="{StaticResource NavButton}" Click="Nav_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource NavGlyph}"><TextBlock Text="日" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                            <TextBlock Grid.Column="1" Text="每日课表" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                        </Grid>
                    </Button>
                    <Button x:Name="WeekNav" Tag="week" Style="{StaticResource NavButton}" Click="Nav_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource NavGlyph}"><TextBlock Text="周" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                            <TextBlock Grid.Column="1" Text="周课表" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                        </Grid>
                    </Button>
                    <Button x:Name="PublicNav" Tag="public" Style="{StaticResource NavButton}" Click="Nav_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource NavGlyph}"><TextBlock Text="校" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                            <TextBlock Grid.Column="1" Text="全校课表" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                        </Grid>
                    </Button>
                    <Button x:Name="ScoresNav" Tag="scores" Style="{StaticResource NavButton}" Click="Nav_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource NavGlyph}"><TextBlock Text="绩" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                            <TextBlock Grid.Column="1" Text="成绩中心" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Content="账号与偏好设置" Style="{StaticResource GhostButton}" Click="Settings_Click" Margin="0,0,0,12"/>
                    <Border Background="#EDF4FF" CornerRadius="16" Padding="14">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="当前身份" Foreground="#71809A" FontSize="10"/>
                                <TextBlock x:Name="AccountText" Foreground="#1D4E9E" FontWeight="SemiBold" FontSize="13" Margin="0,3,0,0"/>
                                <TextBlock x:Name="TermText" Foreground="#7890B3" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="#22B573" VerticalAlignment="Top" Margin="8,3,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,20,28,28">
            <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="A C A D E M I C   D E S K T O P" Foreground="#2B6BEA" FontSize="9" FontWeight="Bold"/>
                    <TextBlock x:Name="PageTitle" Text="每日课表" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Ellipse Width="6" Height="6" Fill="#22B573" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="本地缓存" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="收起到托盘" Style="{StaticResource GhostButton}" Click="Hide_Click" Margin="0,0,10,0"/>
                    <Button x:Name="RefreshButton" Content="更新个人课表" Style="{StaticResource PrimaryButton}" Click="Refresh_Click"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="#FEFFFFFF" CornerRadius="24" BorderBrush="#E4E9F1" BorderThickness="1" Padding="24">
                <Border.Effect><DropShadowEffect Color="#223C65" BlurRadius="22" ShadowDepth="5" Opacity="0.07"/></Border.Effect>
                <Grid x:Name="PageHost"/>
            </Border>
        </Grid>
    </Grid>
</Window>
