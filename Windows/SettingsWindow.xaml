<Window x:Class="UsSDAU.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号与设置" Icon="/Assets/UsSDAU-icon-v2.ico" Width="780" Height="650"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="CheckBox">
                    <Grid Width="44" Height="24">
                        <Border x:Name="Track" CornerRadius="12" Background="#CDD5E1"/>
                        <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.18"/></Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#2167F5"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/><Setter Property="BorderBrush" Value="#DDE4EE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#F8FAFD"/>
        </Style>
    </Window.Resources>
    <Border CornerRadius="25" Background="White" BorderBrush="#DDE4EE" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#10213D" BlurRadius="35" ShadowDepth="10" Opacity="0.24"/></Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="242"/><ColumnDefinition/></Grid.ColumnDefinitions>

            <Border CornerRadius="24,0,0,24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#10213D" Offset="0"/><GradientStop Color="#164BA8" Offset="0.62"/><GradientStop Color="#18A8CC" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="30,36,28,30">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <Border Width="76" Height="76" CornerRadius="24" Background="#18FFFFFF" HorizontalAlignment="Left">
                            <Image Source="/Assets/UsSDAU-logo-square-v2.png" Margin="8"/>
                        </Border>
                        <TextBlock Text="UsSDAU" Foreground="White" FontSize="27" FontWeight="SemiBold" Margin="0,20,0,2"/>
                        <TextBlock Text="连接课程、成绩与每一天" Foreground="#BFD9FF" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="✓  本地账号级缓存" Foreground="#E7F2FF" FontSize="13" Margin="0,0,0,16"/>
                        <TextBlock Text="✓  桌面课程灵动岛" Foreground="#E7F2FF" FontSize="13" Margin="0,0,0,16"/>
                        <TextBlock Text="✓  多学期成绩与成绩单" Foreground="#E7F2FF" FontSize="13"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="密码由 Windows 凭据管理器保护，不写入设置文件。" Foreground="#AFC8E9" FontSize="10" TextWrapping="Wrap" LineHeight="17"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="34,24,28,26">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Text="账号与运行设置" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="验证账号后自动载入本地课表；普通偏好修改不会重复联网。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="36" Height="36" Content="×" FontSize="21" Background="#F0F3F7" BorderThickness="0" Cursor="Hand" Click="Cancel_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,25,0,15">
                    <StackPanel>
                        <TextBlock Text="教务系统账号" FontWeight="SemiBold" FontSize="12"/>
                        <Border Style="{StaticResource FieldBox}" Margin="0,7,0,16"><TextBox x:Name="AccountBox" Height="44" BorderThickness="0" Background="Transparent" FontSize="15" VerticalContentAlignment="Center"/></Border>
                        <TextBlock Text="教务系统密码" FontWeight="SemiBold" FontSize="12"/>
                        <Border Style="{StaticResource FieldBox}" Margin="0,7,0,16"><PasswordBox x:Name="PasswordBox" Height="44" BorderThickness="0" Background="Transparent" FontSize="15" VerticalContentAlignment="Center"/></Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="个人课表学期" FontWeight="SemiBold" FontSize="12"/>
                                <Border Style="{StaticResource FieldBox}" Margin="0,7,0,0"><TextBox x:Name="TermBox" Height="44" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/></Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="第一周周一" FontWeight="SemiBold" FontSize="12"/>
                                <DatePicker x:Name="StartDatePicker" Height="44" Margin="0,7,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F5F8FC" CornerRadius="15" Padding="16,10" Margin="0,21,0,0">
                            <StackPanel>
                                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="桌面课表灵动岛" FontWeight="SemiBold"/><TextBlock Text="跟随每日课表日期展示" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><CheckBox x:Name="IslandCheck" Grid.Column="1" Style="{StaticResource Switch}"/></Grid>
                                <Grid Margin="0,9,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="非临近课程时使用紧凑岛" FontWeight="SemiBold"/><TextBlock Text="课前 30 分钟自动恢复完整课程条" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><CheckBox x:Name="CompactIslandCheck" Grid.Column="1" Style="{StaticResource Switch}"/></Grid>
                                <Grid Margin="0,9,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="课前 30 分钟提醒" FontWeight="SemiBold"/><TextBlock Text="检测到全屏应用时静默" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><CheckBox x:Name="ReminderCheck" Grid.Column="1" Style="{StaticResource Switch}"/></Grid>
                                <Grid Margin="0,9,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="登录 Windows 后运行" FontWeight="SemiBold"/><TextBlock Text="默认仅驻留托盘" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><CheckBox x:Name="StartupCheck" Grid.Column="1" Style="{StaticResource Switch}"/></Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="StatusText" Foreground="#D84A4A" Margin="2,13,0,0" TextWrapping="Wrap" FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Content="取消" Style="{StaticResource GhostButton}" Click="Cancel_Click"/>
                    <Button x:Name="SaveButton" Grid.Column="2" Content="验证并保存" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
