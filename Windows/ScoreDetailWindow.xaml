<Window x:Class="UsSDAU.Windows.ScoreDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="成绩详情" Icon="/Assets/UsSDAU-icon-v2.ico" Width="650" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="ScoreProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/><Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#E3E9F3"/><Setter Property="Foreground" Value="#2167F5"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                    <Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/></Grid>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="24" Background="White" BorderBrush="#DCE3ED" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#10213D" BlurRadius="32" ShadowDepth="9" Opacity="0.23"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition/></Grid.RowDefinitions>
            <Grid Margin="22,0,14,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="10" Background="#EDF3FF"><Image Source="/Assets/UsSDAU-logo-square-v2.png" Margin="4"/></Border>
                    <TextBlock Text="成绩构成" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Width="36" Height="36" Content="×" FontSize="20" Background="#F0F3F7" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="30,10,30,28">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border CornerRadius="19" Background="#F5F8FD" BorderBrush="#E2E8F2" BorderThickness="1" Padding="22">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CourseText" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="MetaText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" FontFamily="Times New Roman, Microsoft YaHei UI"/>
                            <TextBlock Text="点击成绩时从教务系统实时读取构成" Foreground="#93A0B3" FontSize="10" Margin="0,12,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="86" Height="86" CornerRadius="28" Background="#E6F0FF" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="总成绩" Foreground="#657892" FontSize="10" HorizontalAlignment="Center"/><TextBlock x:Name="TotalText" FontSize="29" FontWeight="Bold" Foreground="#2167F5" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,18,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border CornerRadius="18" Background="White" BorderBrush="#E1E7F0" BorderThickness="1" Padding="20">
                        <StackPanel>
                            <Grid><TextBlock Text="平时表现" FontSize="15" FontWeight="SemiBold"/><Border HorizontalAlignment="Right" Background="#EDF4FF" CornerRadius="10" Padding="9,4"><TextBlock x:Name="UsualRatioText" Foreground="#2167F5" FontSize="11"/></Border></Grid>
                            <TextBlock x:Name="UsualText" FontFamily="Times New Roman" FontSize="32" FontWeight="Bold" Margin="0,18,0,10"/>
                            <ProgressBar x:Name="UsualProgress" Style="{StaticResource ScoreProgress}"/>
                            <TextBlock x:Name="UsualContributionText" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" CornerRadius="18" Background="White" BorderBrush="#E1E7F0" BorderThickness="1" Padding="20">
                        <StackPanel>
                            <Grid><TextBlock Text="期末考核" FontSize="15" FontWeight="SemiBold"/><Border HorizontalAlignment="Right" Background="#EEF8F5" CornerRadius="10" Padding="9,4"><TextBlock x:Name="FinalRatioText" Foreground="#15815A" FontSize="11"/></Border></Grid>
                            <TextBlock x:Name="FinalText" FontFamily="Times New Roman" FontSize="32" FontWeight="Bold" Margin="0,18,0,10"/>
                            <ProgressBar x:Name="FinalProgress" Style="{StaticResource ScoreProgress}" Foreground="#16A273"/>
                            <TextBlock x:Name="FinalContributionText" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="#F3F6FA" CornerRadius="13" Padding="15,11">
                    <Grid><TextBlock Text="加权计算" FontWeight="SemiBold" Foreground="#52647D"/><TextBlock x:Name="FormulaText" HorizontalAlignment="Right" FontFamily="Times New Roman" FontSize="12" Foreground="#52647D"/></Grid>
                </Border>
                <Button Grid.Row="3" Content="完成" Style="{StaticResource PrimaryButton}" Click="Close_Click" Margin="0,17,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
