<Window x:Class="UsSDAU.Windows.VerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="离线完整性校验" Icon="/Assets/UsSDAU-icon-v2.ico" Width="620" Height="560"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="离线完整性校验" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="扫描成绩单右下二维码，将 USSD1: 开头的文本粘贴到下方。校验完全在本机完成。" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,16">
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBox x:Name="PayloadBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
            <Border x:Name="ResultCard" Grid.Row="1" Background="White" CornerRadius="15" BorderBrush="#E1E6EE" BorderThickness="1" Padding="16" Margin="0,14,0,0" Visibility="Collapsed">
                <StackPanel><TextBlock x:Name="ResultTitle" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ResultText" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button Content="粘贴" Style="{StaticResource GhostButton}" Click="Paste_Click"/>
            <Button Grid.Column="2" Content="验证签名" Style="{StaticResource PrimaryButton}" Click="Verify_Click"/>
        </Grid>
    </Grid>
</Window>
