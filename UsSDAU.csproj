<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\UsSDAU-icon-v2.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\UsSDAU-icon-v2.ico" />
    <Resource Include="Assets\UsSDAU-tray-v2.ico" />
    <Resource Include="Assets\UsSDAU-logo-square-v2.png" />
    <Resource Include="Assets\UsSDAU-logo-watermark-v2.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp-GDI" Version="6.2.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.Formats.Cbor" Version="10.0.15" />
  </ItemGroup>

</Project>
